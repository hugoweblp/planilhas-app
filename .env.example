# Servidor
PORT=3000

# Banco de Dados (MySQL/MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=nome_do_banco

# Segurança JWT — gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TROCAR_ANTES_DO_DEPLOY

# Chave de criptografia AES-256 para campos LGPD (CPF, telefone) — 64 chars hex
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: Se perder esta chave, todos os CPFs criptografados serão ilegíveis. Faça backup seguro!
ENCRYPTION_KEY=TROCAR_ANTES_DO_DEPLOY

# URL base do servidor (usado para geração de links de assinatura)
# dev: http://localhost:3000 | prod: https://seudominio.com.br
APP_URL=http://localhost:3000

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-SEU_SECRET

# Correio Eletrônico — Nodemailer (para envio de OTP)
SMTP_USER=seu@email.com
SMTP_PASS=senha_de_app_gmail

# Identidade do SaaS
ADMIN_EMAIL=admin@seudominio.com
MASTER_KEY=TROCAR_ANTES_DO_DEPLOY

# Gemini AI (para humanização de campos)
GEMINI_API_KEY=SEU_API_KEY

# Origens permitidas para CORS (separar por vírgula)
# ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
