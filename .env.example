# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (MySQL/MariaDB)
# Dev: XAMPP local | Prod: credenciais da Hostinger
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=nome_do_banco

# Segurança JWT
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TROCAR_ANTES_DO_DEPLOY

# Chave da Sala Central (sys-auth-verify.html)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=TROCAR_ANTES_DO_DEPLOY

# Chave de criptografia AES-256 para campos LGPD (CPF, telefone) — 64 chars hex
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: Se perder esta chave, todos os CPFs criptografados ficam ilegíveis. Backup obrigatório!
# ATENÇÃO: NUNCA copiar a chave de produção para o .env local — ambientes têm chaves separadas.
ENCRYPTION_KEY=TROCAR_ANTES_DO_DEPLOY

# Usuário admin inicial — criado automaticamente no startup se não existir no banco
# Pode remover após o primeiro deploy (usuário fica persistido no banco)
ADMIN_PASSWORD=TROCAR_ANTES_DO_DEPLOY

# Identidade do SaaS
ADMIN_EMAIL=admin@seudominio.com

# URL base do servidor
# Dev: http://localhost:3000 | Prod: https://seudominio.com.br
APP_URL=http://localhost:3000

# Origens permitidas para CORS
# Dev: http://localhost:3000 | Prod: https://seudominio.com.br
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-SEU_SECRET

# Correio Eletrônico — Nodemailer (para envio de OTP via Gmail)
SMTP_USER=seu@gmail.com
SMTP_PASS=senha_de_app_gmail

# Gemini AI (para humanização de nomes de escolas)
GEMINI_API_KEY=SEU_API_KEY
